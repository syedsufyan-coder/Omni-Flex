@model OmniFlex.Models.ViewModels.Student.AttendanceViewModel
@{
    ViewData["PageTitle"] = "Attendance";
}

<div class="container-fluid mt-3">

    <!-- 🔽 SEMESTER DROPDOWN (FAST FLEX STYLE) -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Attendance</h4>

        <select class="form-select w-auto shadow-sm" id="semesterSelect">
            <option selected>Spring 2026</option>
            <option>Fall 2025</option>
        </select>

    </div>

    <!-- 📚 COURSE TABS (CLEAN PILLS) -->
    <ul class="nav nav-pills mb-4 gap-2" id="courseTabs">
        @for (int i = 0; i < Model.Courses?.Count; i++)
        {
            var c = Model.Courses[i];
            <li class="nav-item">
                <button class="nav-link attendance-tab @(i==0?"active":"")"
                        data-target="#course_@i">
                    @c.CourseCode
                </button>
            </li>
        }
    </ul>

    <!-- 📊 COURSE PANELS -->
    @for (int i = 0; i < Model.Courses?.Count; i++)
    {
        var c = Model.Courses[i];

        <div id="course_@i" class="attendance-panel @(i==0?"":"d-none")">

            <!-- 📈 STATS CARDS -->
            <div class="row g-3 mb-4">

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 text-center p-3">
                        <small class="text-muted">Total Classes</small>
                        <h4 class="fw-bold">@c.TotalClasses</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 text-center p-3">
                        <small class="text-muted">Attended</small>
                        <h4 class="fw-bold text-success">@c.ClassesAttended</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 text-center p-3">
                        <small class="text-muted">Missed</small>
                        <h4 class="fw-bold text-danger">@c.ClassesMissed</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 text-center p-3">
                        <small class="text-muted">Attendance</small>
                        <h4 class="fw-bold text-primary">
                            @c.AttendancePercentage.ToString("0.0")%
                        </h4>
                    </div>
                </div>

            </div>

            <!-- 📋 TABLE -->
            <div class="card shadow-sm border-0">
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Duration</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (int j = 0; j < c.Records?.Count; j++)
                            {
                                var r = c.Records[j];

                                var statusClass =
                                r.Status == "Present" ? "bg-success" :
                                r.Status == "Absent" ? "bg-danger" :
                                "bg-warning text-dark";

                                <tr>
                                    <td>@(j + 1)</td>
                                    <td>@r.Attendance_Date.ToString("dd MMM yyyy")</td>
                                    <td>@r.Attendance_Day</td>
                                    <td>@r.Duration.ToString("0.00") hrs</td>
                                    <td>
                                        <span class="badge @statusClass px-3 py-2">
                                            @r.Status
                                        </span>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            </div>

        </div>
    }

</div>
@section Scripts {
<script>

document.querySelectorAll('.attendance-tab').forEach(function(btn){

    btn.addEventListener('click', function(){

        // Remove active from all tabs
        document.querySelectorAll('.attendance-tab')
            .forEach(el => el.classList.remove('active'));

        // Activate current
        btn.classList.add('active');

        // Hide all panels
        document.querySelectorAll('.attendance-panel')
            .forEach(el => el.classList.add('d-none'));

        // Show selected panel
        document.querySelector(btn.dataset.target)
            .classList.remove('d-none');

    });

});

</script>
}