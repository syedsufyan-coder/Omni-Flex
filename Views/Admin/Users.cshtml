@model PaginationViewModel<UserViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["PageTitle"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Users Management <span class="text-muted fs-6">(@Model.TotalItems total)</span></h4>
    <button class="btn btn-primary" onclick="openAddUserModal()">
        <i class="bi bi-plus-circle me-2"></i>Add New User
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex gap-2 mb-3">
            <div class="input-group" style="width:300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input id="userSearch" class="form-control" placeholder="Search users by name or email..." />
            </div>
            <select id="roleFilter" class="form-select" style="width:180px;" onchange="filterByRole()">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Instructor">Instructor</option>
                <option value="Student">Student</option>
            </select>
            <button class="btn btn-outline-secondary" onclick="clearFilters()">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </button>
        </div>

        <div class="table-responsive">
            <table id="usersTable" class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int index = (Model.CurrentPage - 1) * Model.ItemsPerPage;
                        @foreach (var user in Model.Items)
                        {
                            index++;
                            <tr data-user-id="@user.UserId" data-role="@user.Role">
                                <td>@index</td>
                                <td><code>@user.UserId</code></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center
                                                    justify-content-center fw-bold"
                                             style="width:32px;height:32px;font-size:12px;">
                                            @user.Initials
                                        </div>
                                        @user.FullName
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = user.Role switch {
                                            "Admin"      => "bg-danger",
                                            "Instructor" => "bg-warning text-dark",
                                            "Student"    => "bg-info text-dark",
                                            _            => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@user.Role</span>
                                </td>
                                <td>@user.Email</td>
                                <td>@user.Department</td>
                                <td>
                                    <span class="badge @(user.Status == "Active" ? "bg-success" : "bg-secondary")">
                                        @user.Status
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            onclick="viewUser('@user.UserId')"
                                            title="View Profile">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (user.Role == "Instructor")
                                    {
                                        <button class="btn btn-sm btn-outline-primary"
                                                onclick="openAssignCourseModal('@user.UserId')"
                                                title="Assign Course">
                                            <i class="bi bi-book me-1"></i>Assign Course
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-warning"
                                            onclick="openEditUserModal('@user.UserId')"
                                            title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="openDeleteUserModal('@user.UserId', '@user.FullName')"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                No users found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            var routeData = ViewContext.RouteData.Values;
            var actionName = routeData["action"]?.ToString() ?? "Users";
            
            <nav aria-label="Users pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" href="@Url.Action(actionName, new { page = Model.CurrentPage - 1 })">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action(actionName, new { page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @((Model!.HasNext) ? "" : "disabled")">
                        <a class="page-link" href="@Url.Action(actionName, new { page = Model!.CurrentPage + 1 })">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="text-center text-muted small">
                Showing @Model!.Items!.Count of @Model!.TotalItems users (Page @Model!.CurrentPage of @Model!.TotalPages)
            </div>
        }
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#1a3a6b;">
                <h5 class="modal-title text-white">
                    <i class="bi bi-person-plus me-2"></i>Add New User
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div id="addUserError"   class="alert alert-danger  d-none"></div>
                <div id="addUserSuccess" class="alert alert-success d-none"></div>

                <!-- Core Identity -->
                <h6 class="text-primary fw-bold mb-3">
                    <i class="bi bi-person-badge me-1"></i>Core Identity
                </h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">User ID <span class="text-danger">*</span></label>
                        <input type="text" id="add_userId" class="form-control"
                               placeholder="e.g. 24K-0899" maxlength="20" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">First Name <span class="text-danger">*</span></label>
                        <input type="text" id="add_firstName" class="form-control"
                               placeholder="First Name" maxlength="50" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Last Name <span class="text-danger">*</span></label>
                        <input type="text" id="add_lastName" class="form-control"
                               placeholder="Last Name" maxlength="50" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" id="add_email" class="form-control"
                               placeholder="e.g. k240899@nu.edu.pk" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select id="add_deptId" class="form-select">
                            <option value="">-- Select Department --</option>
                            <option value="D01">D01 — Computer Science</option>
                            <option value="D02">D02 — Software Engineering</option>
                            <option value="D03">D03 — Information Technology</option>
                            <option value="D04">D04 — Artificial Intelligence</option>
                            <option value="D05">D05 — Data Science</option>
                            <option value="D06">D06 — Cyber Security</option>
                            <option value="D07">D07 — Computer Engineering</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">User Role <span class="text-danger">*</span></label>
                        <select id="add_role" class="form-select" onchange="onAddRoleChange()">
                            <option value="">-- Select Role --</option>
                            <option value="Admin">Admin</option>
                            <option value="Instructor">Instructor</option>
                            <option value="Student">Student</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Status</label>
                        <select id="add_status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <!-- Role Specific Detaiks -->
                <div id="add_roleDetails" style="display:none;">
                    <hr />
                    <h6 class="text-primary fw-bold mb-3">
                        <i class="bi bi-info-circle me-1"></i>Role Details
                    </h6>

                    <!-- Student Fields -->
                    <div id="add_studentFields" style="display:none;">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Batch Year <span class="text-danger">*</span></label>
                                <input type="number" id="add_batch" class="form-control"
                                       placeholder="e.g. 2024" min="2000" max="2099" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Degree Program <span class="text-danger">*</span></label>
                                <select id="add_degree" class="form-select">
                                    <option value="">-- Select Department --</option>
                                    <option value="D01">D01 — Computer Science</option>
                                    <option value="D02">D02 — Software Engineering</option>
                                    <option value="D03">D03 — Information Technology</option>
                                    <option value="D04">D04 — Artificial Intelligence</option>
                                    <option value="D05">D05 — Data Science</option>
                                    <option value="D06">D06 — Cyber Security</option>
                                    <option value="D07">D07 — Computer Engineering</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Instructor Fields -->
                    <div id="add_instructorFields" style="display:none;">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Designation <span class="text-danger">*</span></label>
                                <select id="add_designation" class="form-select">
                                    <option value="">-- Select Designation --</option>
                                    <option value="Lecturer">Lecturer</option>
                                    <option value="Assistant Professor">Assistant Professor</option>
                                    <option value="Associate Professor">Associate Professor</option>
                                    <option value="Professor">Professor</option>
                                    <option value="Visiting Faculty">Visiting Faculty</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Office Room</label>
                                <input type="text" id="add_officeRoom" class="form-control"
                                       placeholder="e.g. A2-201" maxlength="20" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Specialization</label>
                            <input type="text" id="add_specialization" class="form-control"
                                   placeholder="e.g. Machine Learning, Computer Networks" maxlength="100" />
                        </div>
                    </div>

                    <!-- Admin Fields -->
                    <div id="add_adminFields" style="display:none;">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Designation</label>
                                <input type="text" id="add_adminDesignation" class="form-control"
                                       placeholder="e.g. System Administrator" maxlength="50" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Office Room</label>
                                <input type="text" id="add_adminOfficeRoom" class="form-control"
                                       placeholder="e.g. Admin Block" maxlength="20" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Personal Information -->
                <hr />
                <h6 class="text-primary fw-bold mb-3">
                    <i class="bi bi-person-lines-fill me-1"></i>Personal Information
                </h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Gender</label>
                        <select id="add_gender" class="form-select">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" id="add_dob" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text" id="add_phone" class="form-control"
                               placeholder="e.g. 0300-1234567" maxlength="20" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <input type="text" id="add_address" class="form-control"
                           placeholder="Street address" maxlength="200" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">City</label>
                        <input type="text" id="add_city" class="form-control"
                               placeholder="City" maxlength="50" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Country</label>
                        <input type="text" id="add_country" class="form-control"
                               value="Pakistan" maxlength="50" />
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="submitAddUser()">
                    <i class="bi bi-person-plus me-1"></i>Save User
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header" style="background:#1a3a6b;">
                <h5 class="modal-title text-white">
                    <i class="bi bi-pencil-square me-2"></i>Edit User
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div id="editUserError"   class="alert alert-danger  d-none"></div>
                <div id="editUserSuccess" class="alert alert-success d-none"></div>

                <input type="hidden" id="edit_userId" />
                <input type="hidden" id="edit_role" />

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:25%">Field</th>
                                <th style="width:37%">Current Value</th>
                                <th style="width:38%">New Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Core fields -->
                            <tr>
                                <td>User ID</td>
                                <td><input id="edit_cur_userId" class="form-control form-control-sm" disabled /></td>
                                <td><span class="text-muted small">Cannot be changed</span></td>
                            </tr>
                            <tr>
                                <td>First Name <span class="text-danger">*</span></td>
                                <td><input id="edit_cur_firstName" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_firstName" class="form-control form-control-sm" placeholder="New first name" maxlength="50" /></td>
                            </tr>
                            <tr>
                                <td>Last Name <span class="text-danger">*</span></td>
                                <td><input id="edit_cur_lastName" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_lastName" class="form-control form-control-sm" placeholder="New last name" maxlength="50" /></td>
                            </tr>
                            <tr>
                                <td>Email <span class="text-danger">*</span></td>
                                <td><input id="edit_cur_email" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_email" type="email" class="form-control form-control-sm" placeholder="New email" /></td>
                            </tr>
                            <tr>
                                <td>Department <span class="text-danger">*</span></td>
                                <td><input id="edit_cur_dept" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_dept" class="form-select form-select-sm">
                                        <option value="">-- Select Department --</option>
                                        <option value="D01">D01 — Computer Science</option>
                                        <option value="D02">D02 — Software Engineering</option>
                                        <option value="D03">D03 — Information Technology</option>
                                        <option value="D04">D04 — Artificial Intelligence</option>
                                        <option value="D05">D05 — Data Science</option>
                                        <option value="D06">D06 — Cyber Security</option>
                                        <option value="D07">D07 — Computer Engineering</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>Phone</td>
                                <td><input id="edit_cur_phone" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_phone" class="form-control form-control-sm" placeholder="New phone" maxlength="20" /></td>
                            </tr>
                            <tr>
                                <td>Gender</td>
                                <td><input id="edit_cur_gender" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_gender" class="form-select form-select-sm">
                                        <option value="">-- Select --</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>City</td>
                                <td><input id="edit_cur_city" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_city" class="form-control form-control-sm" placeholder="New city" maxlength="50" /></td>
                            </tr>
                            <tr>
                                <td>Status</td>
                                <td><input id="edit_cur_status" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_status" class="form-select form-select-sm">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </td>
                            </tr>

                            <!-- Student-only rows -->
                            <tr class="edit_studentRow" style="display:none;">
                                <td>Batch Year</td>
                                <td><input id="edit_cur_batch" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_batch" type="number" class="form-control form-control-sm" placeholder="e.g. 2024" min="2000" max="2099" /></td>
                            </tr>
                            <tr class="edit_studentRow" style="display:none;">
                                <td>Degree</td>
                                <td><input id="edit_cur_degree" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_degree" class="form-select form-select-sm">
                                        <option value="">-- Select Degree --</option>
                                        <option value="BSCS">BS Computer Science</option>
                                        <option value="BSAI">BS Artificial Intelligence</option>
                                        <option value="BSSE">BS Software Engineering</option>
                                        <option value="BSCY">BS Cyber Security</option>
                                        <option value="BSDS">BS Data Science</option>
                                        <option value="BSEE">BS Electrical Engineering</option>
                                    </select>
                                </td>
                            </tr>

                            <!-- Instructor-only rows -->
                            <tr class="edit_instructorRow" style="display:none;">
                                <td>Designation</td>
                                <td><input id="edit_cur_designation" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_designation" class="form-select form-select-sm">
                                        <option value="">-- Select --</option>
                                        <option value="Lecturer">Lecturer</option>
                                        <option value="Assistant Professor">Assistant Professor</option>
                                        <option value="Associate Professor">Associate Professor</option>
                                        <option value="Professor">Professor</option>
                                        <option value="Visiting Faculty">Visiting Faculty</option>
                                    </select>
                                </td>
                            </tr>
                            <tr class="edit_instructorRow" style="display:none;">
                                <td>Office Room</td>
                                <td><input id="edit_cur_office" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_office" class="form-control form-control-sm" placeholder="e.g. A2-201" maxlength="20" /></td>
                            </tr>
                            <tr class="edit_instructorRow" style="display:none;">
                                <td>Specialization</td>
                                <td><input id="edit_cur_spec" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_spec" class="form-control form-control-sm" placeholder="e.g. Machine Learning" maxlength="100" /></td>
                            </tr>

                            <!-- Admin-only rows -->
                            <tr class="edit_adminRow" style="display:none;">
                                <td>Designation</td>
                                <td><input id="edit_cur_adminDesignation" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_adminDesignation" class="form-control form-control-sm" placeholder="e.g. System Administrator" maxlength="50" /></td>
                            </tr>
                            <tr class="edit_adminRow" style="display:none;">
                                <td>Office Room</td>
                                <td><input id="edit_cur_adminOffice" class="form-control form-control-sm" disabled /></td>
                                <td><input id="edit_new_adminOffice" class="form-control form-control-sm" placeholder="e.g. Admin Block" maxlength="20" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-1">
                    <i class="bi bi-info-circle me-1"></i>
                    Fill only the fields you wish to update. Empty fields keep their current value.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitEditUser()">
                    <i class="bi bi-pencil me-1"></i>Update User
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View Profile Model -->
<div class="modal fade" id="viewUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#1a3a6b;">
                <h5 class="modal-title text-white">
                    <i class="bi bi-person-circle me-2"></i>User Profile
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="viewUserBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading profile...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Course to Instructor Modal -->
<div class="modal fade" id="assignCourseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#1a3a6b;">
                <h5 class="modal-title text-white">
                    <i class="bi bi-book me-2"></i>Assign Course to Instructor
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="assignCourseError" class="alert alert-danger d-none"></div>
                <div id="assignCourseSuccess" class="alert alert-success d-none"></div>

                <input type="hidden" id="assign_instructorId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Instructor</label>
                    <p class="text-muted" id="assign_instructorName">-</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Select Course <span class="text-danger">*</span></label>
                    <select id="assign_courseId" class="form-select" onchange="loadSectionsForCourse()">
                        <option value="">-- Select a Course --</option>
                    </select>
                    <div class="form-text">Only active courses are shown.</div>
                </div>

                <div class="mb-3" id="sectionSelectionDiv" style="display:none;">
                    <label class="form-label fw-bold">Select Section <span class="text-danger">*</span></label>
                    <select id="assign_sectionId" class="form-select">
                        <option value="">-- Select a Section --</option>
                    </select>
                    <div class="form-text">Select an existing section to assign this instructor.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Currently Assigned Courses</label>
                    <div id="currentAssignedCourses" class="mt-2">
                        <p class="text-muted small">Loading...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAssignCourse()">
                    <i class="bi bi-book me-1"></i>Assign Course
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete User Modal-->
<div class="modal fade" id="deleteUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle me-2"></i>Delete User
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-0">
                <p class="text-muted mb-1">Are you sure you want to delete:</p>
                <p class="fw-bold fs-5" id="delete_userName"></p>
                <input type="hidden" id="delete_userId" />

                <div id="deleteUserError" class="alert alert-danger d-none"></div>

                <div class="alert alert-warning border-0 small d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>
                        <strong>Permanent Action:</strong> This cannot be undone.
                        <span class="d-block">User must not have linked enrollments or sections.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" onclick="submitDeleteUser()">
                    <i class="bi bi-trash me-1"></i>Confirm Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}