@model IEnumerable<OmniFlex.Models.ViewModels.Admin.CourseViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["PageTitle"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4>Courses</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCourseModal">
    <i class="bi bi-plus-circle me-2"></i>Add New Course
  </button>
</div>

<div class="card">
  <div class="card-body">
    <div class="input-group mb-3" style="width: 300px;">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input id="courseSearch" class="form-control" placeholder="Search courses..." />
    </div>
    <div class="table-responsive">
      <table id="coursesTable" class="table table-hover">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th class="sortable">Course Code <i class="bi bi-sort sort-icon ms-1"></i></th>
            <th class="sortable">Course Name <i class="bi bi-sort sort-icon ms-1"></i></th>
            <th>Department</th>
            <th>Credit Hrs</th>
            <th>Enrolled / Max</th>
            <th>Instructor Assigned</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var course in Model)
          {
              int index;
              index = Model.ToList().IndexOf(course) + 1;
              var pct = course.Seats > 0 ? (course.Enrolled * 100 / course.Seats) : 0;
              var barColor = pct >= 100 ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success";
              <tr>
                  <td>@index</td>
                  <td>@course.CourseId</td>
                  <td>@course.CourseName</td>
                  <td>@course.Department</td>
                  <td>@course.CreditHrs</td>
                  <td>
                      <div>@course.Enrolled / @course.Seats</div>
                      <div class="progress mt-1" style="height:4px">
                          <div class="progress-bar @barColor" style="width:@pct%"></div>
                      </div>
                  </td>
                  <td>@course.Instructor</td>
                  <td>
                      <span class="badge @(course.Status == "Active" ? "bg-success" : course.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                          @course.Status
                      </span>
                  </td>
                  <td>
                      <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="View"><i class="bi bi-eye"></i></button>
                      <button class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Assign Instructor"><i class="bi bi-person-plus"></i></button>
                      <button class="btn btn-sm btn-outline-warning" data-bs-toggle="tooltip" title="Edit"><i class="bi bi-pencil"></i></button>
                      <button class="btn btn-sm btn-outline-danger btn-delete" data-course-name="@course.CourseName" data-bs-toggle="tooltip" title="Delete"><i class="bi bi-trash"></i></button>
                  </td>
              </tr>
          }
        </tbody>
      </table>
    </div>
    <nav aria-label="Courses pagination">
      <ul class="pagination justify-content-center">
        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <li class="page-item active"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
      </ul>
    </nav>
  </div>
</div>

<!-- Add Course Modal -->
<div class="modal fade" id="addCourseModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Course</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Course Code</label>
              <input type="text" class="form-control" placeholder="e.g. CS-101" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Course Name</label>
              <input type="text" class="form-control" placeholder="e.g. Programming Fundamentals" />
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Credit Hours</label>
              <select class="form-select">
                <option>1</option>
                <option>2</option>
                <option selected>3</option>
                <option>4</option>
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Department</label>
              <select class="form-select">
                <option>CS</option>
                <option>EE</option>
                <option>MT</option>
                <option>HU</option>
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Max Enrollment</label>
              <input type="number" class="form-control" value="80" />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="3" placeholder="Course description..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary">Add Course</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/admin-courses.js" asp-append-version="true"></script>
}
