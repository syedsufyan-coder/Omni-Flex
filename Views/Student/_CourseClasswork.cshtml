@model OmniFlex.Models.ViewModels.Student.CourseDetailsViewModel

<div class="row gy-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="mb-1">Classwork</h5>
                        <p class="text-muted mb-0">Assignments, quizzes and classroom tasks are listed here.</p>
                    </div>
                    <span class="badge bg-primary">@Model.ClassworkItems.Count items</span>
                </div>
                <div class="row g-3">
                    @foreach (var item in Model.ClassworkItems)
                    {
                        <div class="col-12">
                            <div class="card rounded-4 border shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="mb-1">@item</h6>
                                            <p class="text-muted small mb-0">Assigned by @Model.InstructorName</p>
                                        </div>
                                        <span class="badge bg-secondary">Open</span>
                                    </div>
                                    <div class="text-muted">Review details, attachments, and submission instructions from the instructor.</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
