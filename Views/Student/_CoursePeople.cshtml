@model OmniFlex.Models.ViewModels.Student.CourseDetailsViewModel

<div class="row gy-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="mb-3">People</h5>
                <p class="text-muted">View instructors, TAs, and course participants.</p>
                <div class="list-group list-group-flush">
                    <div class="list-group-item px-0 py-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:48px; height:48px; font-size:1.05rem;">@Model.InstructorName.Substring(0,1)</div>
                            <div>
                                <h6 class="mb-1">@Model.InstructorName</h6>
                                <span class="text-muted">Instructor</span>
                            </div>
                        </div>
                    </div>
                    @foreach (var person in Model.People)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:44px; height:44px;">@person[0]</div>
                                <div>
                                    <h6 class="mb-1">@person</h6>
                                    <span class="text-muted">Student</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-uppercase text-muted mb-3">Course summary</h6>
                <p>@Model.CourseDescription</p>
                <div class="mt-4">
                    <div class="d-flex justify-content-between text-muted mb-2"><span>Course code</span><strong>@Model.CourseId</strong></div>
                    <div class="d-flex justify-content-between text-muted mb-2"><span>Section</span><strong>@Model.Section</strong></div>
                    <div class="d-flex justify-content-between text-muted"><span>Batch</span><strong>@Model.Batch</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>
