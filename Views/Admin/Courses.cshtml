@model IEnumerable<OmniFlex.Models.ViewModels.Admin.CourseViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["PageTitle"] = "Courses";
}

<!-- Filter Form — Added by Abdur Rehman Khan -->
<div class="card mb-3">
    <div class="card-body">
        <h6 class="card-title mb-3">
            <i class="bi bi-funnel me-2"></i>Filter Courses
        </h6>

        <!-- Row 1 — Filter type dropdown -->
        <div class="d-flex align-items-center gap-3 mb-2">
            <label class="form-label mb-0" style="min-width:120px;">Filter By</label>
            <select id="filterType"
                    class="form-select"
                    style="max-width:220px;"
                    onchange="onFilterTypeChange()">
                <option value="">-- Select a filter --</option>
                <option value="TeacherId">Teacher</option>
                <option value="DeptId">Department</option>
                <option value="CourseType">Course Type</option>
                <option value="CourseCat">Course Category</option>
                <option value="SectionId">Section</option>
                <option value="PreReqId">Pre-Requisite</option>
                <option value="CreditHrs">Credit Hours</option>
            </select>
        </div>

        <!-- Row 2 — Value input, hidden until filter type selected -->
        <div id="filterValueRow"
             class="d-flex align-items-center gap-3 mb-2"
             style="display:none !important;">
            <label id="filterValueLabel"
                   class="form-label mb-0"
                   style="min-width:120px;">Value</label>
            <input id="filterValue"
                   type="text"
                   class="form-control"
                   style="max-width:220px;"
                   placeholder="Select a filter first" />
            <button id="filterBtn"
                    class="btn btn-primary"
                    onclick="filterCourses()">
                <i class="bi bi-search me-1"></i>Search
            </button>
            <button class="btn btn-secondary"
                    onclick="clearFilter()">
                <i class="bi bi-x-circle me-1"></i>Clear
            </button>
        </div>

        <!-- Error message — hidden by default -->
        <div id="filterError"
             class="text-danger small mt-1"
             style="display:none;">
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4>Courses</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCourseModal">
    <i class="bi bi-plus-circle me-2"></i>Add New Course
  </button>
</div>

<div class="card">
  <div class="card-body">
    <div class="input-group mb-3" style="width: 300px;">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input id="courseSearch" class="form-control" placeholder="Search courses..." />
    </div>
    <div class="table-responsive">
      <table id="coursesTable" class="table table-hover">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th class="sortable">Course Code <i class="bi bi-sort sort-icon ms-1"></i></th>
            <th class="sortable">Course Name <i class="bi bi-sort sort-icon ms-1"></i></th>
            <th>Credit Hours</th>
            <th>Course Type</th>
            <th>Course Category</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var course in Model)
          {
              int index;
              index = Model.ToList().IndexOf(course) + 1;
              <tr>
                  <td>@index</td>
                  <td>@course.CourseId</td>
                  <td>@course.CourseName</td>
                  <td>@course.CreditHrs</td>
                  <td>@course.CourseType</td>
                  <td>@course.CourseCat</td>
                  <td>@course.Status</td>
                  <td>
                      <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="View"><i class="bi bi-eye"></i></button>
                      <button class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Assign Instructor"><i class="bi bi-person-plus"></i></button>
                      <button class="btn btn-sm btn-outline-warning" data-bs-toggle="tooltip" title="Edit"><i class="bi bi-pencil"></i></button>
                      <button class="btn btn-sm btn-outline-danger btn-delete" data-course-name="@course.CourseName" data-bs-toggle="tooltip" title="Delete"><i class="bi bi-trash"></i></button>
                  </td>
              </tr>
          }
        </tbody>
      </table>
    </div>
    <nav aria-label="Courses pagination">
      <ul class="pagination justify-content-center">
        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <li class="page-item active"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
      </ul>
    </nav>
  </div>
</div>

<!-- CREATE COURSE MODAL -->

<div class="modal fade" id="addCourseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div id="createCourseError" class="alert alert-danger d-none"></div>
                <div id="createCourseSuccess" class="alert alert-success d-none"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Course Code <span class="text-danger">*</span></label>
                        <input type="text" id="create_courseId" class="form-control"
                               placeholder="e.g. CS2005" maxlength="10" />
                        <div class="form-text">Unique identifier — e.g. CS2005, CL2005</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Course Name <span class="text-danger">*</span></label>
                        <input type="text" id="create_courseName" class="form-control"
                               placeholder="e.g. Advanced DBMS" maxlength="50" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select id="create_deptId" class="form-select">
                            <option value="">-- Select Department --</option>
                            <option value="CS">CS — Computer Science</option>
                            <option value="AI">AI — Artificial Intelligence</option>
                            <option value="SE">SE — Software Engineering</option>
                            <option value="CY">CY — Cyber Security</option>
                            <option value="DS">DS — Data Science</option>
                            <option value="EE">EE — Electrical Engineering</option>
                            <option value="SH">SH — Sciences & Humanities</option>
                            <option value="MG">MG — Management</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Credit Hours <span class="text-danger">*</span></label>
                        <select id="create_creditHrs" class="form-select">
                            <option value="">-- Select Credit Hours </option>
                            <option value="1">1 </option>
                            <option value="2">2 </option>
                            <option value="3">3 </option>
                            <option value="4">4 </option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Course Type <span class="text-danger">*</span></label>
                        <select id="create_courseType" class="form-select">
                            <option value="">-- Select Course Type --</option>
                            <option value="Theory">Theory</option>
                            <option value="Lab">Lab</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Course Category <span class="text-danger">*</span></label>
                        <select id="create_courseCat" class="form-select">
                            <option value="">-- Select Course Category --</option>
                            <option value="Core">Core</option>
                            <option value="Elective">Elective</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Prerequisite Course ID</label>
                        <input type="text" id="create_preReqId" class="form-control"
                               placeholder="e.g. CS2001 (Optional)" maxlength="10" />
                        <div class="form-text">Leave Empty If No Prerequisite</div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitCreateCourse()">
                    <i class="bi bi-plus-circle me-1"></i>Add Course
                </button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT COURSE MODAL -->
<div class="modal fade" id="editCourseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div id="editCourseError" class="alert alert-danger d-none"></div>
                <div id="editCourseSuccess" class="alert alert-success d-none"></div>

                <input type="hidden" id="edit_courseId" />

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:30%">Field</th>
                                <th style="width:35%">Current Value</th>
                                <th style="width:35%">New Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><label class="form-label mb-0">Course Code</label></td>
                                <td><input type="text" id="edit_current_courseId" class="form-control form-control-sm" disabled /></td>
                                <td><span class="text-muted small">Cannot be changed !</span></td>
                            </tr>
                            <tr>
                                <td><label class="form-label mb-0">Course Name <span class="text-danger">*</span></label></td>
                                <td><input type="text" id="edit_current_courseName" class="form-control form-control-sm" disabled /></td>
                                <td><input type="text" id="edit_new_courseName" class="form-control form-control-sm" placeholder="New name" maxlength="50" /></td>
                            </tr>
                            <tr>
                                <td><label class="form-label mb-0">Department <span class="text-danger">*</span></label></td>
                                <td><input type="text" id="edit_current_deptId" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_deptId" class="form-select form-select-sm">
                                        <option value="">-- Select Department --</option>
                                        <option value="CS">CS</option>
                                        <option value="AI">AI</option>
                                        <option value="SE">SE</option>
                                        <option value="CY">CY</option>
                                        <option value="DS">DS</option>
                                        <option value="EE">EE</option>
                                        <option value="SH">SH</option>
                                        <option value="MG">MG</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label mb-0">Credit Hours <span class="text-danger">*</span></label></td>
                                <td><input type="text" id="edit_current_creditHrs" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_creditHrs" class="form-select form-select-sm">
                                        <option value="">-- Select Credit Hours --</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label mb-0">Course Type <span class="text-danger">*</span></label></td>
                                <td><input type="text" id="edit_current_courseType" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_courseType" class="form-select form-select-sm">
                                        <option value="">-- Select Course Type --</option>
                                        <option value="Theory">Theory</option>
                                        <option value="Lab">Lab</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label mb-0">Course Category <span class="text-danger">*</span></label></td>
                                <td><input type="text" id="edit_current_courseCat" class="form-control form-control-sm" disabled /></td>
                                <td>
                                    <select id="edit_new_courseCat" class="form-select form-select-sm">
                                        <option value="">-- Select Course Category --</option>
                                        <option value="Core">Core</option>
                                        <option value="Elective">Elective</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label mb-0">Prerequisite</label></td>
                                <td><input type="text" id="edit_current_preReqId" class="form-control form-control-sm" disabled /></td>
                                <td><input type="text" id="edit_new_preReqId" class="form-control form-control-sm" placeholder="e.g. CS2001" maxlength="10" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-1">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Instruction:</strong> Fill only the fields you wish to update.
                    Any field left blank will retain its current value.
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitEditCourse()">
                    <i class="bi bi-pencil me-1"></i>Update Course
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCourseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title text-danger fw-bold">Delete Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-0">
                <p class="text-muted mb-1">Are you sure you want to delete:</p>
                <p class="fw-bold fs-5" id="delete_courseName"></p>

                <div id="deleteCourseError" class="alert alert-danger d-none"></div>

                <div class="alert alert-warning border-0 small d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>
                        <strong>Action Permanent:</strong> This cannot be undone.
                        <span class="d-block text-decoration-underline">Course must not be assigned to any section.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 shadow-sm" onclick="submitDeleteCourse()">
                    <i class="bi bi-trash me-1"></i> Confirm Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
  <script src="~/js/admin-courses.js" asp-append-version="true"></script>
}
