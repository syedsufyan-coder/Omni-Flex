@model IEnumerable<OmniFlex.Models.ViewModels.Admin.SectionViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["PageTitle"] = "Sections";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4>Sections</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSectionModal">
    <i class="bi bi-plus-circle me-2"></i>Add New Section
  </button>
</div>

<div class="card">
  <div class="card-body">
    <div class="input-group mb-3" style="width: 300px;">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input id="sectionSearch" class="form-control" placeholder="Search sections..." />
    </div>
    <div class="table-responsive">
      <table id="sectionsTable" class="table table-hover">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th class="sortable">Section Code <i class="bi bi-sort sort-icon ms-1"></i></th>
            <th class="sortable">Course <i class="bi bi-sort sort-icon ms-1"></i></th>
            <th>Instructor</th>
            <th>Room</th>
            <th>Schedule</th>
            <th>Enrolled / Max</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        @if (Model != null)
        {
            var index = 0;
            foreach (var sectionItem in Model)
            {
                index++;
                var pct = sectionItem.Seats > 0 ? (sectionItem.Enrolled * 100 / sectionItem.Seats) : 0;
                var statusClass = pct >= 100 ? "bg-danger" : sectionItem.Instructor == "Unassigned" ? "bg-warning text-dark" : "bg-success";
                var statusText = pct >= 100 ? "Full" : sectionItem.Instructor == "Unassigned" ? "Pending" : "Active";
                <tr>
                    <td>@index</td>
                    <td>@sectionItem.SectionId</td>
                    <td>@sectionItem.SectionLabel</td>
                    <td>@sectionItem.CourseName</td>
                    <td>@sectionItem.RoomNo</td>
                    <td>@sectionItem.TimeSlot</td>
                    <td>@sectionItem.Enrolled / @sectionItem.Seats</td>
                    <td><span class="badge @statusClass">@statusText</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="View"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Assign Instructor"><i class="bi bi-person-plus"></i></button>
                        <button class="btn btn-sm btn-outline-info" data-bs-toggle="tooltip" title="Transfer Students"><i class="bi bi-arrow-left-right"></i></button>
                        <button class="btn btn-sm btn-outline-danger btn-delete" data-course-name="@sectionItem.SectionId" data-bs-toggle="tooltip" title="Delete"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
        }
        </tbody>
      </table>
    </div>
    <nav aria-label="Sections pagination">
      <ul class="pagination justify-content-center">
        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <li class="page-item active"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
      </ul>
    </nav>
  </div>
</div>

@section Scripts {
    <script src="~/js/admin-sections.js" asp-append-version="true"></script>
}
