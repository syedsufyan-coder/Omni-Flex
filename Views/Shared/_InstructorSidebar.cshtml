@{
    string active = ViewData["ActivePage"]?.ToString() ?? "";
}
<nav class="d-flex flex-column h-100">
  <div class="mb-3 d-flex align-items-center gap-2">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5z" fill="#fff"/></svg>
    <div>
      <div style="font-family:Sora;color:#fff">OMNI-FLEX</div>
      <small style="font-family:Sora;color:#fff">Instructor Portal</small>
    </div>
  </div>

  <div class="d-flex align-items-center gap-2 mb-3">
    <div class="avatar" style="width:40px;height:40px;border-radius:50%;background:#0EA5E9;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;">@(Context.Session.GetString("UserName")?.Split(' ')[0][0] ?? 'I')</div>
    <div>
      <div class="text-white" style="font-family:Sora">@(Context.Session.GetString("UserName") ?? "Instructor User")</div>
      <div><span class="badge bg-primary">@(Context.Session.GetString("Role") ?? "Instructor")</span></div>
    </div>
  </div>

  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item"><a class="nav-link @(active=="Dashboard"?"active":"")" asp-controller="Instructor" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
    <li class="nav-item"><a class="nav-link @(active=="Courses"?"active":"")" asp-controller="Instructor" asp-action="Courses"><i class="bi bi-book-open me-2"></i>Courses</a></li>
    <li class="nav-item"><a class="nav-link @(active=="WeeklyCalendar"?"active":"")" asp-controller="Instructor" asp-action="WeeklyCalendar"><i class="bi bi-calendar3 me-2"></i>Weekly Calendar</a></li>
    <li class="nav-item"><a class="nav-link @(active=="ManageAttendance"?"active":"")" asp-controller="Instructor" asp-action="ManageAttendance"><i class="bi bi-person-check me-2"></i>Manage Attendance</a></li>
  </ul>

  <div class="mt-auto">
    <a href="/auth/logout" class="btn btn-ghost w-100 text-start text-white" style="border:none"><i class="bi bi-box-arrow-left me-2"></i>Logout</a>
  </div>
</nav>
