@model OmniFlex.Models.ViewModels.Student.TranscriptViewModel
@{
    ViewData["PageTitle"] = "Transcript";
}

<div class="row mb-3">
    <div class="col-md-6">
        <p><strong>Roll No:</strong> @Model.RollNo</p>
        <p><strong>Name:</strong> @Model.StudentName</p>
    </div>
    <div class="col-md-6">
        <p><strong>Degree:</strong> @Model.Degree</p>
        <p><strong>Batch:</strong> @Model.Batch</p>
    </div>
</div>

<div class="card p-3">
    <div class="d-flex justify-content-between mb-3">
        <h5>Transcript</h5>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">Print / Export</button>
    </div>

    @foreach (var s in Model.Semesters ?? new List<OmniFlex.Models.ViewModels.Student.SemesterTranscript>())
    {
        <div class="mb-4">
            <h6>@s.SemesterLabel</h6>
            <div class="mb-2">Cr. Att: @s.CreditHoursAttempted | Cr. Ernd: @s.CreditHoursEarned | CGPA: @s.CGPA.ToString("F2") | SGPA: @s.SGPA.ToString("F2")</div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead><tr><th>Code</th><th>Course Name</th><th>Section</th><th>CrdHrs</th><th>Grade</th><th>Points</th><th>Type</th></tr></thead>
                    <tbody>
                        @foreach (var c in s.Courses)
                        {
                            <tr>
                                <td>@c.Code</td>
                                <td>@c.CourseName</td>
                                <td>@c.Section</td>
                                <td>@c.CreditHours</td>
                                <td>@c.Grade</td>
                                <td>@c.GradePoints</td>
                                <td>@c.Type</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <hr />
        </div>
    }
</div>
