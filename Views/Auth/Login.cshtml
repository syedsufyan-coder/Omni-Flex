@model OmniFlex.Models.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="bg-mesh auth d-flex align-items-center justify-content-center" style="min-height:100vh">
  <div class="card auth-card animate__animated animate__zoomIn">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z" fill="#1E40AF"/></svg>
        <div>
          <h5 class="m-0" style="font-family:Sora">OMNI-FLEX</h5>
          <div class="d-flex align-items-center gap-2">
            <i id="roleIcon" class="bi"></i>
            <small id="roleBadge" class="badge bg-primary role-badge">@Model.Role</small>
          </div>
        </div>
      </div>

      <form asp-controller="Auth" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Role" />

        <div class="mb-3">
          <label asp-for="UserId" class="form-label">Employee / Roll Number</label>
          <input asp-for="UserId" class="form-control" placeholder="e.g. 21L-1234" />
          <span asp-validation-for="UserId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Password" class="form-label">Password</label>
          <div class="input-group">
            <input asp-for="Password" type="password" class="form-control" id="passwordInput" />
            <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1"><i class="bi bi-eye" id="eyeIcon"></i></button>
          </div>
          <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" />
          <label class="form-check-label" for="rememberMe">
            Remember me
          </label>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
              Invalid credentials. Please try again.
            </div>
        }

        <button type="submit" class="btn btn-primary w-100 rounded-pill">Sign In</button>
        <div class="text-center mt-3"><a class="text-muted" href="#">Forgot password?</a></div>
      </form>

      <div class="text-center auth-back mt-3"><a href="/" class="text-white-50">? Back to Portal</a></div>
    </div>
  </div>
</main>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
