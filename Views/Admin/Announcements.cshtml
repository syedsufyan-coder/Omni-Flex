@model IEnumerable<OmniFlex.Models.ViewModels.Admin.AnnouncementViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["PageTitle"] = "Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4>Announcements</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newAnnouncementModal">
    <i class="bi bi-plus-circle me-2"></i>New Announcement
  </button>
</div>

<div class="announcements-list">
  @foreach (var ann in Model)
  {
      var priorityClass = ann.Priority switch {
          "Urgent"    => "bg-danger",
          "Important" => "bg-primary",
          _           => "bg-secondary"
      };
      <div class="card mb-3">
          <div class="card-header d-flex justify-content-between align-items-center">
              <span class="fw-semibold">@ann.Title</span>
              <div class="d-flex align-items-center gap-2">
                  <span class="badge @priorityClass">@ann.Priority</span>
                  @if (ann.IsPinned)
                  {
                      <i class="bi bi-pin-fill text-warning"></i>
                  }
              </div>
          </div>
          <div class="card-body">
              <p class="card-text">@ann.Content</p>
          </div>
          <div class="card-footer text-muted small d-flex justify-content-between">
              <span>
                  Posted by @ann.PostedByName • 
                  Audience: @ann.Audience • 
                  @ann.TimeAgo
              </span>
              <div>
                  <i class="bi bi-pencil me-2 cursor-pointer"></i>
                  <i class="bi bi-trash text-danger cursor-pointer"></i>
              </div>
          </div>
      </div>
  }
</div>

@section Scripts {
  <script src="~/js/admin-announcements.js" asp-append-version="true"></script>
}
