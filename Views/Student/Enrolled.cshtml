@model OmniFlex.Models.ViewModels.Student.EnrolledViewModel
@{
    ViewData["PageTitle"] = "Enrolled";
}

<h3>My Classes</h3>
<div class="row g-3 mt-2">
    @foreach (var cls in Model.ActiveClasses ?? new List<OmniFlex.Models.ViewModels.Student.ClassCard>())
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="p-3 text-white" style="background-color:@(cls.BannerColorClass);min-height:90px;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1 text-white">@cls.CourseCode</h5>
                            <div>@cls.CourseName</div>
                            <small>@cls.TeacherName</small>
                        </div>
                        <span class="badge bg-white text-dark">@cls.Section</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-sm btn-primary" asp-controller="Student" asp-action="Enrolled">Open</a>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Archive</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
