@model OmniFlex.Models.ViewModels.Instructor.InstructorClassroomViewModel

<div class="d-flex justify-content-end mb-3">
  <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addAssessmentModal">
    <i class="bi bi-clipboard-plus me-2"></i>Add Assessment
  </button>
</div>

@if (!Model.Assignments.Any())
{
  <div class="text-center text-muted py-5">
    <i class="bi bi-clipboard display-4"></i>
    <p class="mt-2">No assessments yet. Add one to get started.</p>
  </div>
}
else
{
  <div class="list-group shadow-sm">
    @foreach (var assignment in Model.Assignments.OrderBy(a => a.DueDate))
    {
      <div class="list-group-item list-group-item-action border-0 mb-3 rounded-3 shadow-sm">
        <div class="d-flex align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;background:#eef2ff;">
              <i class="bi bi-clipboard-check text-primary"></i>
            </div>
            <div>
              <div class="fw-semibold">@assignment.Title</div>
              <div class="text-muted small">
                <span class="badge bg-light text-dark border me-1">@assignment.Category</span>
                @if (assignment.DueDate.HasValue)
                {
                  <span>Due @assignment.DueDate.Value.ToString("dd MMM yyyy")</span>
                }
                else
                {
                  <span>No due date</span>
                }
              </div>
            </div>
          </div>
          <div class="text-end">
            <div class="fw-bold text-primary">@assignment.TotalMarks pts</div>
            <div class="text-muted small">@assignment.SubmissionCount / @assignment.TotalEnrolled submitted</div>
          </div>
        </div>

        <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2 align-items-center">
          <button class="btn btn-outline-primary btn-sm btn-view-assignment" data-assignment-id="@assignment.AssignmentId">
            <i class="bi bi-eye me-1"></i>View Instructions
          </button>
          <button class="btn btn-success btn-sm btn-grade-assignment" data-assignment-id="@assignment.AssignmentId">
            <i class="bi bi-award me-1"></i>Grade
          </button>
          <div class="ms-auto d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm">Edit</button>
            <button class="btn btn-outline-danger btn-sm">Delete</button>
          </div>
        </div>
      </div>
    }
  </div>
}
