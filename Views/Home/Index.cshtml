@{
    Layout = null;
    ViewData["Title"] = "Welcome";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - OMNI-FLEX</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
<section class="hero-container animate__animated animate__fadeInDown">
  <div class="container text-center">
    <div class="hero-logo mb-3">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z" fill="#fff"/></svg>
      <h1>OMNI-FLEX</h1>
      <p id="typed-subtitle" class="hero-sub">FAST-NUCES Learning Management System</p>
    </div>

    <div class="row mt-4 role-cards">
      <div class="col-sm-6 col-md-3 mb-3">
        <div class="card role-card animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
          <div class="card-body text-center">
            <div class="role-icon mb-2"><i class="bi bi-shield-check text-white"></i></div>
            <h5 class="mb-1" style="font-family:Sora">Admin</h5>
            <p class="mb-2 text-white-75">System Control & Management</p>
            <a href="/auth/login?role=admin" class="role-enter">Enter Portal →</a>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-md-3 mb-3">
        <div class="card role-card animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
          <div class="card-body text-center">
            <div class="role-icon mb-2"><i class="bi bi-person-workspace text-white"></i></div>
            <h5 class="mb-1" style="font-family:Sora">Instructor</h5>
            <p class="mb-2 text-white-75">Teach, Grade & Manage Classes</p>
            <a href="/auth/login?role=instructor" class="role-enter">Enter Portal →</a>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-md-3 mb-3">
        <div class="card role-card animate__animated animate__fadeInUp" style="animation-delay: 0.3s;">
          <div class="card-body text-center">
            <div class="role-icon mb-2"><i class="bi bi-clipboard2-check text-white"></i></div>
            <h5 class="mb-1" style="font-family:Sora">Teaching Assistant</h5>
            <p class="mb-2 text-white-75">Support, Quiz & Grade</p>
            <a href="/auth/login?role=ta" class="role-enter">Enter Portal →</a>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-md-3 mb-3">
        <div class="card role-card animate__animated animate__fadeInUp" style="animation-delay: 0.4s;">
          <div class="card-body text-center">
            <div class="role-icon mb-2"><i class="bi bi-book-half text-white"></i></div>
            <h5 class="mb-1" style="font-family:Sora">Student</h5>
            <p class="mb-2 text-white-75">Learn, Submit & Track Progress</p>
            <a href="/auth/login?role=student" class="role-enter">Enter Portal →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-note">© 2025 FAST-NUCES. All rights reserved.</div>
</section>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/typed.js@2.1.0/dist/typed.umd.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/landing.js" asp-append-version="true"></script>
</body>
</html>
