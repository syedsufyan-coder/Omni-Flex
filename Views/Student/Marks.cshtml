@model OmniFlex.Models.ViewModels.Student.MarksViewModel
@{
    ViewData["PageTitle"] = "Marks";
}

<div class="mb-3">
    @for (int i = 0; i < Model.Courses?.Count; i++)
    {
        var c = Model.Courses[i];
        <button class="btn btn-outline-primary marks-tab @(i==0?"active":"")" data-target="#course_@i">
            @c.CourseCode <span class="badge bg-secondary">@c.EnrollmentStatus</span>
        </button>
    }
</div>

@for (int i = 0; i < Model.Courses?.Count; i++)
{
    var c = Model.Courses[i];
    <div id="course_@i" class="marks-panel @(i==0?"":"d-none")">
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <div><b>@c.CourseCode</b> - @c.CourseName</div>
                <span class="badge bg-info">@c.EnrollmentStatus</span>
            </div>
            <small>@c.Section</small>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead><tr><th>Component</th><th>Obtained</th><th>Total</th><th>%</th><th>Remarks</th></tr></thead>
                <tbody>
                    @foreach (var a in c.Assessments)
                    {
                        var color = a.Percentage >= 80 ? "text-success" : a.Percentage >= 60 ? "text-warning" : "text-danger";
                        <tr>
                            <td>@a.Component</td>
                            <td>@a.ObtainedMarks</td>
                            <td>@a.TotalMarks</td>
                            <td class="@color">@a.Percentage.ToString("0.0")%</td>
                            <td>@a.Remarks</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total</th>
                        <th>@c.TotalObtained</th>
                        <th>@c.TotalMax</th>
                        <th>@(c.TotalMax > 0 ? (c.TotalObtained / c.TotalMax * 100).ToString("0.0") : "0.0")%</th>
                        <th>—</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.marks-tab').forEach(function(btn){
            btn.addEventListener('click', function(){
                document.querySelectorAll('.marks-tab').forEach(el=>el.classList.remove('active'));
                btn.classList.add('active');
                document.querySelectorAll('.marks-panel').forEach(el=>el.classList.add('d-none'));
                document.querySelector(btn.getAttribute('data-target')).classList.remove('d-none');
            });
        });
    </script>
}
